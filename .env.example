# Infinitix Control Panel - Environment Configuration

# ============================================
# SERVER CONFIGURATION
# ============================================
NODE_ENV=production
PORT=3000

# Mode: demo | production | hybrid
# - demo: Only demo mode with fake data
# - production: Only real webhooks and database
# - hybrid: Both demo and production features enabled
MODE=production

# ============================================
# DATABASE CONFIGURATION (PostgreSQL)
# ============================================

# Option 1: Use DATABASE_URL (Railway automatic)
DATABASE_URL=postgresql://postgres:password@postgres.railway.internal:5432/railway

# Option 2: Individual components (if DATABASE_URL not set)
# DB_HOST=postgres.railway.internal
# DB_PORT=5432
# DB_NAME=railway
# DB_USER=postgres
# DB_PASSWORD=your-password-here

# ============================================
# SECURITY
# ============================================

# Webhook Secret for n8n authentication
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET=your-secret-key-here

# ============================================
# SYNC CONFIGURATION
# ============================================

# How often to sync with database (milliseconds)
SYNC_INTERVAL=30000

# How many days of history to load on startup
INITIAL_LOAD_DAYS=7

# ============================================
# LOGGING (Optional)
# ============================================

# Log level: debug | info | warn | error
LOG_LEVEL=info

# ============================================
# OPTIONAL FEATURES
# ============================================

# Enable/disable specific features
# ENABLE_DEMO=true
# ENABLE_ANALYTICS=false
