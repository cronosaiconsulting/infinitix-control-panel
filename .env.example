# Infinitix Control Panel - Environment Configuration

# ============================================
# SERVER CONFIGURATION
# ============================================
NODE_ENV=production
PORT=3000

# Mode: demo | production | hybrid
# - demo: Only demo mode with fake data
# - production: Only real webhooks and database
# - hybrid: Both demo and production features enabled
MODE=production

# ============================================
# DATABASE CONFIGURATION (PostgreSQL)
# ============================================

# Use your existing PostgreSQL database
# Internal network (recommended for same Railway project):
DATABASE_URL=postgresql://railway:bel8ZBdHIZ4mqm-BEt_xFYkGCuCR5bkV@postgres.railway.internal:5432/railway

# Or external hostname (if needed):
# DATABASE_URL=postgresql://railway:bel8ZBdHIZ4mqm-BEt_xFYkGCuCR5bkV@postgres-production-b37d4.up.railway.app:5432/railway

# ============================================
# SECURITY
# ============================================

# Webhook Secret for n8n authentication
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET=your-secret-key-here

# ============================================
# DATA LOADING CONFIGURATION
# ============================================

# How many days of history to load on startup (default: 365 days = 1 year)
# Set to higher value to load more historical messages on reload
INITIAL_LOAD_DAYS=365

# ============================================
# WEBHOOK BEHAVIOR
# ============================================

# IMPORTANT: Webhooks DO NOT write to database
# - Your n8n workflow should write to chat_messages_v2 table
# - Webhooks only broadcast messages to connected clients in real-time
# - On page reload, all messages are loaded from database

# NO PERIODIC SYNC:
# - While interface is open, updates come ONLY via webhooks
# - Database is read ONLY on page reload to load historical messages
# - No background polling or syncing while clients are connected

# ============================================
# LOGGING (Optional)
# ============================================

# Log level: debug | info | warn | error
LOG_LEVEL=info

# ============================================
# OPTIONAL FEATURES
# ============================================

# Enable/disable specific features
# ENABLE_DEMO=true
# ENABLE_ANALYTICS=false
